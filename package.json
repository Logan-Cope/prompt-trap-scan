{
  "name": "prompt-trap-scan",
  "version": "0.1.0",
  "description": "Find text on a web page that is aimed at an AI and hidden from a human.",
  "license": "MIT",
  "private": true,
  "main": "src/scan.js",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "preflight": "node scripts/preflight.mjs",
    "eval": "node scripts/preflight.mjs && node eval/run.mjs",
    "eval:write": "node scripts/preflight.mjs && node eval/run.mjs --write",
    "pretest": "node scripts/preflight.mjs",
    "test":"node --test \"test/*.test.mjs\"",
    "serve": "npm run build && npx --no-install serve dist -l 4173",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "playwright": "^1.50.0",
    "serve": "^14.2.0",
    "typescript": "^5.6.0"
  }
}
